MONGODB_URI=mongodb://127.0.0.1:27017/finance_tracker_v2?replicaSet=rs0
# In production, replace MONGODB_URI with the intended Atlas URI. URL-encode URI credentials.
# This value overrides any database name embedded in MONGODB_URI. Select only the intended database.
MONGODB_DB=finance_tracker_v2
# Server-only; generate a unique random value of at least 32 characters. Never expose to browser code.
PIN_PEPPER=replace-with-a-random-secret-of-at-least-32-characters
# Local E2E only; the server also requires development mode, loopback MongoDB, and an _e2e database.
# Keep false in normal development and do not configure test mode for production.
E2E_TEST_MODE=false
E2E_TEST_USER_EMAIL=e2e@example.test
