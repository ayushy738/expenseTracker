MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/expenseTracker?retryWrites=true&w=majority
# Explicitly overrides any database name in MONGODB_URI. Use a new empty DB.
MONGODB_DB=finance_tracker_v2
# Generate 32+ random bytes, encoded as hex or base64. Server only; used to harden 4-digit PIN verifiers.
PIN_PEPPER=replace-with-at-least-32-random-characters
